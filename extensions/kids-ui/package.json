{
  "name": "@openclaw/kids-ui",
  "version": "2026.10.1",
  "private": true,
  "description": "A minimal browser interface for a child's assigned tutor",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "assets",
    "pets",
    "automation",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openclaw/kids-activity-contract": "workspace:*",
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "workerEntries": [
        "./src/activity-store.worker.ts"
      ],
      "staticAssets": [
        {
          "source": "./pets/rocky-reference.webp",
          "output": "pets/rocky-reference.webp"
        },
        {
          "source": "./pets/rocky-bored.webp",
          "output": "pets/rocky-bored.webp"
        },
        {
          "source": "./pets/rocky-sleeping.webp",
          "output": "pets/rocky-sleeping.webp"
        }
      ]
    },
    "compat": {
      "pluginApi": ">=2026.10.1",
      "minGatewayVersion": "2026.10.1"
    }
  }
}
